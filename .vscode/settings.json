{
  // Masked self-attention for humans: no peeking at the tokens ahead.
  //
  // These apply to THIS workspace only. Your other projects keep their
  // completions. Nothing here is global.

  // The universal kill switch: stops inline "ghost text" suggestions from
  // ANY provider (Copilot, Codeium, Tabnine, Supermaven, Continue, ...).
  "editor.inlineSuggest.enabled": false,

  // Provider-specific belt-and-braces, in case one ignores the setting above.
  "github.copilot.enable": {
    "*": false,
    "python": false,
    "markdown": false,
    "plaintext": false
  },
  "github.copilot.inlineSuggest.enable": false,
  "github.copilot.editor.enableAutoCompletions": false,
  "codeium.enableCodeLens": false,
  "codeium.enableSearch": false,
  "tabnine.disable_line_suggestions": true,
  "supermaven.enable": false,

  // Also stop whole-function AI edits from being offered unprompted.
  "editor.inlineSuggest.showToolbar": "never",
  "chat.editing.autoAcceptDelay": 0,

  // Ordinary IntelliSense stays ON -- it completes `nums.` into list methods
  // and resolves imports, which is normal Python tooling rather than the
  // answer. To go full monk mode, flip these two to false / "off":
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.suggestOnTriggerCharacters": true,

  // Practice-friendly editor defaults for this repo.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["blind75"],
  "python.testing.unittestEnabled": false,
  "editor.rulers": [88],
  "files.trimTrailingWhitespace": true
}
